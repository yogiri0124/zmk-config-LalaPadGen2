#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include "lalapadgen2-layouts.dtsi"
#include <behaviors/cursor_slow.dtsi>
#include <behaviors/tp_keys.dtsi>
// トラックパッドのタップ・ジェスチャーを割り当てるキーの位置 POS_TP_*（自作モジュールの C と共通）
#include <dt-bindings/lalapad/tp_positions.h>

/ {
    chosen {
        zmk,physical-layout = &lalapadgen2_physical_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <7>;
        map = <
            RC(0,0)	RC(0,1)	RC(0,2)	RC(0,3)	RC(0,4)	        	    RC(0,7)	RC(0,8)	RC(0,9)	RC(0,10) RC(0,11)
            RC(1,0)	RC(1,1)	RC(1,2)	RC(1,3)	RC(1,4)	       		    RC(1,7)	RC(1,8)	RC(1,9)	RC(1,10) RC(1,11)
            RC(2,0)	RC(2,1)	RC(2,2)	RC(2,3)	RC(2,4)	       		    RC(2,7)	RC(2,8)	RC(2,9)	RC(2,10) RC(2,11)
            RC(3,0)	RC(3,1)	RC(3,2)	RC(3,3)	RC(3,4)	RC(3,5)	RC(3,6)	RC(3,7)	RC(3,8)	RC(3,9)	RC(3,10) RC(3,11)
                    RC(4,1) RC(4,2)	RC(4,3)	RC(4,4)	RC(4,5)	RC(4,6)	RC(4,7)	RC(4,8)	RC(4,9)	RC(4,10)
            RC(5,0)	RC(5,1) RC(5,2)                                                 RC(5,9)	RC(5,10) RC(5,11)
            RC(6,0)	RC(6,1) RC(6,2)	RC(6,3)	RC(6,4)                 RC(6,7)	RC(6,8) RC(6,9)	RC(6,10) RC(6,11)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    // 右のトラックパッドの入力を、子機の右から親機の左へ中継する（右の overlay で device を指定して送る側にする。
    // 親機の左では、受け取った入力を出す入力デバイスになる）。左のトラックパッドは親機に直接つながっているので中継しない
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split_R: trackpad_split_R@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    behaviors {
        tp_to_pos: tp_to_pos {
            compatible = "zmk,behavior-trackpad-to-pos";
            #binding-cells = <1>;
        };
    };

    trackpad_key_behaviors_R: trackpad_key_behaviors_R {
        compatible = "zmk,input-processor-behaviors-consume";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        codes = <
                    INPUT_BTN_0
                    INPUT_BTN_1
                    INPUT_BTN_2
                    INPUT_BTN_3
                    INPUT_BTN_4
                    INPUT_BTN_5
                    INPUT_BTN_6
                    INPUT_BTN_7
                    >;
        bindings = <
                    &tp_to_pos  POS_TP_LCLK_R
                    &tp_to_pos  POS_TP_RCLK_R
                    &tp_to_pos  POS_TP_MCLK_R
                    &tp_to_pos  POS_TP_SWIPE_RIGHT_R
                    &tp_to_pos  POS_TP_SWIPE_LEFT_R
                    &tp_to_pos  POS_TP_SWIPE_UP_R
                    &tp_to_pos  POS_TP_SWIPE_DOWN_R
                    &tp_to_pos  POS_TP_PINCH_R
                    >;
    };
    trackpad_key_behaviors_L: trackpad_key_behaviors_L {
        compatible = "zmk,input-processor-behaviors-consume";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        codes = <
                    INPUT_BTN_0
                    INPUT_BTN_1
                    INPUT_BTN_2
                    INPUT_BTN_3
                    INPUT_BTN_4
                    INPUT_BTN_5
                    INPUT_BTN_6
                    INPUT_BTN_7
                    >;
        bindings = <
                    &tp_to_pos  POS_TP_LCLK_L
                    &tp_to_pos  POS_TP_RCLK_L
                    &tp_to_pos  POS_TP_MCLK_L
                    &tp_to_pos  POS_TP_SWIPE_RIGHT_L
                    &tp_to_pos  POS_TP_SWIPE_LEFT_L
                    &tp_to_pos  POS_TP_SWIPE_UP_L
                    &tp_to_pos  POS_TP_SWIPE_DOWN_L
                    &tp_to_pos  POS_TP_PINCH_L
                    >;
    };

    zip_dynamic_xy_scaler: zip_dynamic_xy_scaler {
        compatible = "zmk,input-processor-dynamic-scaler";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        scale-group = <ZDS_XY>;
        track-remainders;
    };

    zip_dynamic_scroll_scaler: zip_dynamic_scroll_scaler {
        compatible = "zmk,input-processor-dynamic-scaler";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        scale-group = <ZDS_SC>;
        track-remainders;
    };

    // オートマウスレイヤー: トラックパッド操作でマウスレイヤーを一時的に有効化する（自作: lalapad/src/input_processor_auto_mouse_layer.c）。
    // マウスレイヤーで &trans 以外のキー（&none を含む）と excluded-positions のキーは「マウス操作」として扱い、
    // 押しても解除せず、押している間は時間切れにしない（離してから数え直す）。「マウス操作」でないキーを押すと
    // 即解除し、&trans の位置のキーは下のレイヤー（Default など）のキーとして入力される。
    // 有効にするきっかけはカーソル移動・スクロールだけ（タップ・ジェスチャー、触れただけでは有効にしない）。
    // リスナーの入力処理の最後に入れるので、速度の調整の後の、実際にカーソルが動く量で有効にする。
    // トラックパッドに触れている間も時間切れにしない（離れてから timeout-ms で解除）。触れている合図は
    // ドライバの INPUT_BTN_TOUCH（CONFIG_INPUT_IQS9151_REPORT_TOUCH）で、受け取るデバイスは親機の overlay の touch-devices で指定する。
    // マウスレイヤーに結びつく設定（layer・timeout-ms・excluded-layers・excluded-positions・passive-positions）は
    // keymap に書く（レイヤーの #define は keymap にあり、ここからは見えないため）。
    zip_auto_mouse_layer: zip_auto_mouse_layer {
        compatible = "zmk,input-processor-auto-mouse-layer";
        #input-processor-cells = <0>;
        require-prior-idle-ms = <150>;
    };

    // 左右のトラックパッドのリスナー（親機の overlay で status = "okay" にする。右は子機から中継した入力、
    // 左は親機に直接つながったトラックパッド）。
    // カーソル低速: &zip_cursor_slow は keymap の cur_slow_hold / cur_slow_toggle / cur_slow_once で低速がオンの間だけカーソルを 1/3 にする。
    // レイヤーによって速さは変えない（以前は数字・記号レイヤーの間を遅くしていた）。数字・記号レイヤーの間に
    // マウスレイヤーを新しくオンにしないのは、keymap の &zip_auto_mouse_layer の excluded-layers で行う。
    // トラックパッドをキー操作に変える: &zip_tp_keys は keymap の zmk,behavior-tp-keys・zmk,behavior-tp-stroke のキーを
    // 押している間だけ、動きをキーの入力に変え、タップ・ジェスチャーを捨てる（自作: lalapad/src/tp_keys.c）。
    // タップ・ジェスチャーを捨てるため trackpad_key_behaviors より前に、動きの量を生の値で数えるため scaler より前に、
    // 変えた動きでマウスレイヤーをオンにしないためオートマウスレイヤーより前に、つまり先頭に入れる。
    // INPUT_BTN_TOUCH（触れている／離れた）もここで止める（リスナーは使わない。オートマウスレイヤーは
    // 入力デバイスから直接受け取る）。
    // 左右のリスナーの入力処理の並び（左右で同じにする。違うのはタップ・ジェスチャーの位置と、スクロールスナップの入り口）。
    // key_behaviors: タップ・ジェスチャーをキー位置に変える処理、snap: スクロールスナップ（ふだんは入り口の gate）
    #define LALAPAD_TP_PROCESSORS(key_behaviors, snap)                                                 \
        <&zip_tp_keys>, <&key_behaviors>, <&zip_xy_scaler 1 5>, <&zip_scroll_scaler 1 12>,             \
            <&zip_dynamic_xy_scaler>, <&zip_cursor_slow 1 3>, <&zip_dynamic_scroll_scaler>, <&snap>,   \
            <&zip_auto_mouse_layer>
    trackpad_listener_R: trackpad_listener_R {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpad_split_R>;
        input-processors = LALAPAD_TP_PROCESSORS(trackpad_key_behaviors_R, zip_scroll_snap_gate_R);
    };
    trackpad_listener_L: trackpad_listener_L {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&iqs9151>;
        input-processors = LALAPAD_TP_PROCESSORS(trackpad_key_behaviors_L, zip_scroll_snap_gate_L);
    };

    aliases {
        led-red = &led0;
        led-green = &led1;
        led-blue = &led2;
    };

    leds {
        compatible = "gpio-leds";
        status = "okay";
        led0: led_0 {
            gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;  // red LED, connected to P1.03
        };
        led1: led_1 {
            gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;  // green LED, connected to P1.05
        };
        led2: led_2 {
            gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;  // blue LED, connected to P1.07
        };
    };

    easy_charge_indicator: easy_charge_indicator {
        compatible = "zmk,easy-charge-indicator";
        status = "okay";
        charge-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
        led-gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
   };
};

// NFC 用のピン（P0.09・P0.10）を普通の GPIO として使う（P0.10 は充電 LED の easy_charge_indicator で使う）。
// Zephyr 3.5 で Kconfig の CONFIG_NFCT_PINS_AS_GPIOS から、この DT のプロパティに移った
&uicr {
    nfct-pins-as-gpios;
};

// TrackPad on I2C
&xiao_i2c {
    status = "okay";

    iqs9151: iqs9151@56 {
        compatible = "azoteq,iqs9151";
        reg = <0x56>;
        status = "okay";
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

// スクロールスナップ (kot149/zmk-scroll-snap): 2本指スクロールを近いほうの軸 (X/Y) に揃える。
// ふだんは使わない（斜めスクロールできるように）。keymap の &scr_snap_hold のキーを押している間だけ、
// 各リスナー（trackpad_listener_R / _L）に入れた &zip_scroll_snap_gate_R / _L がここへイベントを渡す
// （レイヤーは使わない。自作: lalapad/src/input_processor_scroll_snap_gate.c）。
// 特定のレイヤーで常に有効にしたいときは、各リスナーに次のような子ノードを追加する
// （<N> はレイヤー番号、_R / _L は左右で合わせる。入り口の gate の代わりに、スクロールスナップを直接入れる）:
//     snapmode {
//         layers = <N>;
//         input-processors = LALAPAD_TP_PROCESSORS(trackpad_key_behaviors_R, zip_scroll_snap_R);
//     };
// 判定状態（サンプル・軸ロック）は左右のトラックパッドで独立させるため、インスタンスを分ける。
// y-threshold <1 1>: |y| > |x| なら Y 軸。x-threshold <101 100>: |y| < 1.01|x| なら X 軸
// （同量のときも X 軸に決まり、出力が 0 にならない）。斜め判定は未実装で出力 0 になるため使わない。
/ {
    zip_scroll_snap_R: zip_scroll_snap_R {
        compatible = "zmk,input-processor-scroll-snap";
        #input-processor-cells = <0>;
        x-threshold = <101 100>;
        y-threshold = <1 1>;
        xy-threshold = <0 0>;
        require-n-samples = <10>;
        immediate-snap-threshold = <1500>;
        lock-duration-ms = <200>;
        lock-for-next-n-events = <10>;
        idle-reset-timeout-ms = <200>;
    };

    zip_scroll_snap_L: zip_scroll_snap_L {
        compatible = "zmk,input-processor-scroll-snap";
        #input-processor-cells = <0>;
        x-threshold = <101 100>;
        y-threshold = <1 1>;
        xy-threshold = <0 0>;
        require-n-samples = <10>;
        immediate-snap-threshold = <1500>;
        lock-duration-ms = <200>;
        lock-for-next-n-events = <10>;
        idle-reset-timeout-ms = <200>;
    };

    // &scr_snap_hold のキーを押している間だけ、上のスクロールスナップにイベントを渡す入り口
    zip_scroll_snap_gate_R: zip_scroll_snap_gate_R {
        compatible = "zmk,input-processor-scroll-snap-gate";
        #input-processor-cells = <0>;
        processor = <&zip_scroll_snap_R>;
    };

    zip_scroll_snap_gate_L: zip_scroll_snap_gate_L {
        compatible = "zmk,input-processor-scroll-snap-gate";
        #input-processor-cells = <0>;
        processor = <&zip_scroll_snap_L>;
    };
};
