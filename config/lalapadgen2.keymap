        // 億（Shift_JIS 0x89AD）
        kj_oku: kj_oku {
            compatible = "zmk,behavior-alt-code";
            display-name = "億";
            #binding-cells = <0>;
            codes = <35245>;
            commit-ime;
        };

        // --- かな入力（自作モジュール lalapad/）。Keymap Editor が認識できるよう、定義はこのファイルに置く ---
        // かな・編集用のキーを送る（&kana_key KN_A など。ID は lalapad/include/dt-bindings/kana/kana.h。
        // KN_ = かな、KE_ = スペース・エンター・バックスペース・Esc・Tab）。記号は、下の zmk,behavior-kana-seq のキーで送る
        kana_key: kana_key {
            compatible = "zmk,behavior-kana";
            #binding-cells = <1>;
            display-name = "Kana";
        };
        // 漢字を送る（&kanji_key KJ_… など。名前と番号は lalapad/include/dt-bindings/kana/kanji.h。
        // docs/google-ime/kanji.tsv から docs/tools/gen_kanji.py で作る）。番号の符号（「;」＋英字 2 文字）を
        // かなと同じ送信キューで送り、PC 側の Google 日本語入力のローマ字テーブルが漢字に変える。かなモードの間だけ働く。
        // kanji.tsv の「同時押し」に書いたかなのキーを同時に押しても漢字が出る（同時とみなす時間は chord-ms。既定 40 ms）
        kanji_key: kanji_key {
            compatible = "zmk,behavior-kanji";
            #binding-cells = <1>;
            display-name = "Kanji";
        };
        // かな配列モードのオン／オフ（&kana_sw KANA_SW_ON / KANA_SW_OFF）。layer はかな単打面。
        // sub-layers は、かなモードを抜けるときにいっしょに解除するレイヤー（親指を押したまま抜けても残らないように）
        kana_sw: kana_sw {
            compatible = "zmk,behavior-kana-mode";
            #binding-cells = <1>;
            display-name = "Kana Mode";
            layer = <KANA_LAYER>;
            sub-layers = <KANA_L_LAYER KANA_R_LAYER KANA_SYM_LAYER>;
        };

        // --- 記号・カッコ（自作モジュール lalapad/ の zmk,behavior-kana-seq。keys に書いた打鍵を順に送る） ---
        // かな（&kana_key）と同じ送信待ちの列に並ぶので、かなのレイヤーにも、ほかのレイヤーにも置ける。
        // かなモードを抜ける処理の最中に押したときは捨て、送信待ちがあふれたときは順番を守って打ち切る
        // （ZMK 標準のマクロには、この処理がない）。新しい記号は、ここに同じ形で書き足すだけでよい。
        // ime-on: かなモードでないとき、打鍵の前に毎回 IME オン（LANGUAGE_1）を送る（入力後も IME はオンのまま）。
        // かなモード中は、ime-on の有無に関係なく、しばらく打っていなかったとき（と、接続先の切り替えやトラックパッドの
        // クリック・ジェスチャーの後）だけ IME オンを先に送る。

        // --- ks_: かなと一緒に打つ記号 ---
        ks_touten: ks_touten {
            compatible = "zmk,behavior-kana-seq";
            display-name = "、";
            #binding-cells = <0>;
            keys = <COMMA>;
            ime-on;
        };
        ks_kuten: ks_kuten {
            compatible = "zmk,behavior-kana-seq";
            display-name = "。";
            #binding-cells = <0>;
            keys = <DOT>;
            ime-on;
        };
        ks_chouon: ks_chouon {
            compatible = "zmk,behavior-kana-seq";
            display-name = "ー";
            #binding-cells = <0>;
            keys = <MINUS>;
            ime-on;
        };
        ks_excl: ks_excl {
            compatible = "zmk,behavior-kana-seq";
            display-name = "！";
            #binding-cells = <0>;
            keys = <EXCLAMATION>;
            ime-on;
        };
        ks_ques: ks_ques {
            compatible = "zmk,behavior-kana-seq";
            display-name = "？";
            #binding-cells = <0>;
            keys = <QUESTION>;
            ime-on;
        };

        // --- pair_: カッコの自動補完（開き・閉じを入力して ← でカーソルを中に置く） ---
        // 「」を入力してカーソルを中に。[ ] を Google 日本語入力で「」にする
        pair_kagi: pair_kagi {
            compatible = "zmk,behavior-kana-seq";
            display-name = "「」";
            #binding-cells = <0>;
            keys = <LEFT_BRACKET RIGHT_BRACKET LEFT>;
            ime-on;
        };
        // 『』を入力してカーソルを中に。Google 日本語入力の z[ z] で『』にする
        pair_nijukagi: pair_nijukagi {
            compatible = "zmk,behavior-kana-seq";
            display-name = "『』";
            #binding-cells = <0>;
            keys = <Z LEFT_BRACKET Z RIGHT_BRACKET LEFT>;
            ime-on;
        };
        // “” を入力してカーソルを中に。ローマ字テーブルの z{ z} で “ ” にする。
        // PC 側でローマ字テーブルに「z{ → “」「z} → ”」の登録が必要（標準のテーブルにはない）
        pair_cquote_ime: pair_cquote_ime {
            compatible = "zmk,behavior-kana-seq";
            display-name = "“”";
            #binding-cells = <0>;
            keys = <Z LEFT_BRACE Z RIGHT_BRACE LEFT>;
            ime-on;
        };
        // () を入力してカーソルを中に（かなモード以外では IME を切り替えない。IME オンなら（）になる）
        pair_paren: pair_paren {
            compatible = "zmk,behavior-kana-seq";
            display-name = "()";
            #binding-cells = <0>;
            keys = <LPAR RPAR LEFT>;
        };

        // --- sym_: 記号（Google 日本語入力のローマ字テーブル経由） ---
        // … を入力。Google 日本語入力の z. で … にする
        sym_ellipsis: sym_ellipsis {
            compatible = "zmk,behavior-kana-seq";
            display-name = "…";
            #binding-cells = <0>;
            keys = <Z PERIOD>;
            ime-on;
        };
        // ―― （ホリゾンタルバー2つ。ダッシュ）を入力。ローマ字テーブルの z= で ― にするのを2回送る。
        // PC 側でローマ字テーブルに「z= → ―」の登録が必要（標準のテーブルにはない）
        sym_hbar_ime: sym_hbar_ime {
            compatible = "zmk,behavior-kana-seq";
            display-name = "――";
            #binding-cells = <0>;
            keys = <Z EQUAL Z EQUAL>;
            ime-on;
        };
        // ～ を入力。ローマ字テーブルの z- で ～（全角チルダ）にする（標準のテーブルの z- は 〜（波ダッシュ）。
        // docs/google-ime/romantable.txt で ～ に変えている）
        sym_tilde_ime: sym_tilde_ime {
            compatible = "zmk,behavior-kana-seq";
            display-name = "～";
            #binding-cells = <0>;
            keys = <Z MINUS>;
            ime-on;
        };
    };

    // エディタ（LaLapad-Gen2-Editor）が作るマクロ用。
    macros {
    };

    combos {
        compatible = "zmk,combos";

        // Esc・Tab は、数字レイヤー（SECONDARY）では働かない（1・2、6・7 を続けて素早く打ったときに出ないように）
        COMBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <DEFAULT_LAYER CONTROL_LAYER TERTIARY_LAYER SYSTEM_LAYER MOUSE_LAYER>;
        };
        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <DEFAULT_LAYER CONTROL_LAYER TERTIARY_LAYER SYSTEM_LAYER MOUSE_LAYER>;
        };
        // かなの単打の面の Esc・Tab は、かなと同じ送信キューで送る（まだ送り終えていないかなを追い越さないように）
        COMBO_KANA_ESC {
            bindings = <&kana_key KE_ESC>;
            key-positions = <0 1>;
            layers = <KANA_LAYER>;
        };
        COMBO_KANA_TAB {
            bindings = <&kana_key KE_TAB>;
            key-positions = <10 11>;
            layers = <KANA_LAYER>;
        };
        // Default レイヤーだけ: 16＋17 で IME オン、12＋13 で IME オフ。打っている途中で起きないよう、30ms 以内に
        // 両方を押したときだけ（timeout-ms）、直前のキーから 150ms 以上あけて押したときだけ（require-prior-idle-ms）
        COMBO_IME_ON {
            timeout-ms = <30>;
            bindings = <&kp LANGUAGE_1>;
            key-positions = <16 17>;
            layers = <DEFAULT_LAYER>;
            require-prior-idle-ms = <150>;
        };
        COMBO_IME_OFF {
            timeout-ms = <30>;
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 13>;
            layers = <DEFAULT_LAYER>;
            require-prior-idle-ms = <150>;
        };
        // 左手用レイヤー（10）へ: 数字レイヤーの 20＋21 だけ。Default に戻るのは left_hand_4（left_hand で 33 を長押し）の
        // 20＋21 だけ（ほかの左手用レイヤーの 20＋21 では戻らない）
        COMBO_LEFT_HAND_IN {
            bindings = <&to LEFT_HAND_LAYER>;
            key-positions = <20 21>;
            layers = <SECONDARY_LAYER>;
        };
        COMBO_LEFT_HAND_OUT {
            bindings = <&to DEFAULT_LAYER>;
            key-positions = <20 21>;
            layers = <LEFT_HAND4_LAYER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // layer_id_<番号>: は、レイヤーの見分けの番号（1〜255。ほかのレイヤーと重ねない）。レイヤーを作ったときに決め、
        // 名前を変えても並べ替えても変えない（レイヤーと一緒に動かす）。全部のレイヤーに付ける（一部だけだとビルドが止まる）。ファームウェアはこの番号で、ZMK Studio で保存した変更を、
        // レイヤーを並べ替え・足し・消しした後も同じレイヤーに付け替える（lalapad/src/layer_ids.c。README の「レイヤーの見分けの番号」）

        layer_id_1: DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
            &kp F  &kp D  &kp L  &kp W  &kp J  &kp SEMI  &kp P  &kp O  &kp U  &kp COMMA
            &kp S  &kp T  &kp H  &kp C  &kp Y  &kp Q  &kp N  &kp A  &kp E  &kp I
            &mt2 LEFT_SHIFT X  &kp K  &kp M  &kp G  &kp V  &kp Z  &kp B  &kp SQT  &kp SLASH  &kp PERIOD
            &none  &none  &kp LEFT_ALT  &num_mo SECONDARY_LAYER SECONDARY_LAYER  &mt2 LEFT_SHIFT R  &kp ENTER  &kp BACKSPACE  &mt2 RIGHT_CONTROL SPACE  &mo TERTIARY_LAYER  &kp LWIN  &none  &none
            &tog CONTROL_LAYER  &kp RIGHT  &kp DOWN  &kp LEFT  &kp UP  &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT  &kana_sw KANA_SW_ON
