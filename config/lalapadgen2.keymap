#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/kana.dtsi>
#include <behaviors/mouse_button_toggle.dtsi>
#include <dt-bindings/lalapad/cursor_slow.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3
#define MOUSE_LAYER     4
#define KANA_LAYER      5
#define KANA_L_LAYER    6
#define KANA_R_LAYER    7
#define KANA_SYM_LAYER  8
#define NUMBER_LAYER    9
#define SYMBOL_LAYER    10

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

// かな配列モードのオン／オフ（&kana_mode）で有効にするかな単打面
&kana_mode { layer = <KANA_LAYER>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // ===== カスタムキー（まだどのレイヤーにも置いていない。後で割り当てる） =====
        // 名前の頭で種類を分けている（clk_: クリック、cur_: カーソル、mod_: 修飾キー、pair_: カッコ）。
        // display-name は付けない（LaLapad-Gen2-Editor がレイヤーと誤認するため）。

        // --- clk_: クリック押しっぱなし（もう一度押す、または同じボタンのクリックで解除） ---
        // 左クリック押しっぱなし（旧 D.LCK）
        clk_lock_l: clk_lock_l {
            compatible = "zmk,behavior-mouse-button-toggle";
            #binding-cells = <0>;
            button = <LCLK>;
        };
        // 中クリック押しっぱなし（旧 D.MID）
        clk_lock_m: clk_lock_m {
            compatible = "zmk,behavior-mouse-button-toggle";
            #binding-cells = <0>;
            button = <MCLK>;
        };
        // 右クリック押しっぱなし（旧 D.RCK）
        clk_lock_r: clk_lock_r {
            compatible = "zmk,behavior-mouse-button-toggle";
            #binding-cells = <0>;
            button = <RCLK>;
        };

        // --- cur_: カーソル低速（1/3） ---
        // 押している間、カーソル低速（旧 SLOW）
        cur_slow_hold: cur_slow_hold {
            compatible = "zmk,behavior-cursor-slow";
            #binding-cells = <0>;
            mode = <CURSOR_SLOW_HOLD>;
        };
        // 押すたびにカーソル低速のオン・オフ（旧 T.SLO）
        cur_slow_toggle: cur_slow_toggle {
            compatible = "zmk,behavior-cursor-slow";
            #binding-cells = <0>;
            mode = <CURSOR_SLOW_TOGGLE>;
        };
        // 次のキーを押すまでカーソル低速（旧 O.SLO）
        cur_slow_once: cur_slow_once {
            compatible = "zmk,behavior-cursor-slow";
            #binding-cells = <0>;
            mode = <CURSOR_SLOW_ONESHOT>;
        };

        // --- mod_: 修飾キー押しっぱなし（もう一度押すと解除） ---
        // Left Alt 押しっぱなし（旧 A.LCK）
        mod_lock_alt: mod_lock_alt {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LALT>;
        };
        // Left Ctrl 押しっぱなし（旧 C.LCK）
        mod_lock_ctrl: mod_lock_ctrl {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LCTRL>;
        };
        // Left Shift 押しっぱなし（旧 S.LCK）
        mod_lock_shift: mod_lock_shift {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LSHIFT>;
        };
        // Left GUI（Win）押しっぱなし（旧 W.LCK）
        mod_lock_win: mod_lock_win {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LGUI>;
        };
    };



    // --- pair_: カッコの自動補完（開き・閉じを入力して ← でカーソルを中に置く）。まだどのレイヤーにも置いていない ---
    // display-name は付けない（LaLapad-Gen2-Editor がレイヤーと誤認するため）。
    macros {
        // {} を入力してカーソルを中に
        pair_brace: pair_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp LBRC &kp RBRC &kp LEFT>;
        };
        // [] を入力してカーソルを中に
        pair_bracket: pair_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp LBKT &kp RBKT &kp LEFT>;
        };
        // "" を入力してカーソルを中に
        pair_dquote: pair_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp DQT &kp DQT &kp LEFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <DEFAULT_LAYER SECONDARY_LAYER TERTIARY_LAYER SYSTEM_LAYER MOUSE_LAYER>;
        };
        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <DEFAULT_LAYER SECONDARY_LAYER TERTIARY_LAYER SYSTEM_LAYER MOUSE_LAYER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
            &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
            &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &mt2 EQUAL MINUS
            &mt2 LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
            &kp LCTRL  &kp LWIN  &kp LEFT_ALT  &mo 1  &kp SPACE  &kp LEFT_SHIFT  &kp BACKSPACE  &kp ENTER  &mo 2  &kp LANGUAGE_2  &kp LANGUAGE_1  &kp BACKSLASH
            &none  &kp RIGHT  &kp DOWN  &kp LEFT  &kp UP  &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT  &kana_mode KANA_MODE_ON
            &mkp LCLK  &mkp RCLK  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            &mkp MB4  &mkp MB5  &kp LG(TAB)  &kp LG(D)  &kp LCTRL  &mkp MB4  &mkp MB5  &kp LG(TAB)  &kp LG(D)  &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
            &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
            &trans  &trans  &trans  &trans  &trans  &trans  &kp DEL  &trans  &trans  &kp KP_NUMBER_0  &kp KP_DOT  &kp KP_DIVIDE
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
            &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp PAGE_UP  &kp HOME  &kp UP_ARROW  &kp END  &kp PRINTSCREEN
            &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp SCROLLLOCK
            &kp GRAVE  &kp SQT  &kp SEMI  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &mkp MB4  &trans  &mkp MB5  &kp PAUSE_BREAK
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
            &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &sys_reset  &bootloader  &bt BT_CLR  &bt BT_CLR_ALL  &trans
            &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE_LAYER {
            display-name = "mouse_layer";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        KANA_LAYER {
            display-name = "kana";
            bindings = <
            &kana KN_A  &kana KN_I  &kana KN_U  &kana KN_E  &kana KN_O  &kana KN_KA  &kana KN_KI  &kana KN_KU  &kana KN_KE  &kana KN_KO
            &kana KN_SA  &kana KN_SI  &kana KN_SU  &kana KN_SE  &kana KN_SO  &kana KN_TA  &kana KN_TI  &kana KN_TU  &kana KN_TE  &kana KN_TO
            &kana KN_NA  &kana KN_NI  &kana KN_NU  &kana KN_NE  &kana KN_NO  &kana KN_HA  &kana KN_HI  &kana KN_HU  &kana KN_HE  &kana KN_HO
            &none  &none  &none  &kana KN_SPACE  &mo KANA_L_LAYER  &kana KN_BSPC  &none  &mo KANA_R_LAYER  &kana KN_ENTER  &mo KANA_SYM_LAYER  &none  &none
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &kana_mode KANA_MODE_OFF
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        KANA_L_LAYER {
            display-name = "kana_left";
            bindings = <
            &kana KN_MA  &kana KN_MI  &kana KN_MU  &kana KN_ME  &kana KN_MO  &kana KN_YA  &kana KN_YU  &kana KN_YO  &kana KN_WA  &kana KN_WO
            &kana KN_RA  &kana KN_RI  &kana KN_RU  &kana KN_RE  &kana KN_RO  &kana KN_NN  &kana KN_GA  &kana KN_GI  &kana KN_GU  &kana KN_GE
            &kana KN_GO  &kana KN_ZA  &kana KN_ZI  &kana KN_ZU  &kana KN_ZE  &kana KN_ZO  &kana KN_DA  &kana KN_DI  &kana KN_DU  &kana KN_DE
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        KANA_R_LAYER {
            display-name = "kana_right";
            bindings = <
            &kana KN_DO  &kana KN_BA  &kana KN_BI  &kana KN_BU  &kana KN_BE  &kana KN_BO  &kana KN_PA  &kana KN_PI  &kana KN_PU  &kana KN_PE
            &kana KN_PO  &kana KN_XYA  &kana KN_XYU  &kana KN_XYO  &kana KN_XA  &kana KN_XI  &kana KN_XU  &kana KN_XE  &kana KN_XO  &kana KN_XTU
            &kana KN_VU  &kana KN_TOUTEN  &kana KN_KUTEN  &kana KN_CHOUON  &kana KN_SANTEN  &kana KN_EXCL  &kana KN_QUES  &kana KN_KAGI  &kana KN_NIJUKAGI  &kana KN_PAREN
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // かな記号面（かな単打面の位置39を押している間）。記号は後で配置する。今は文字キー（0〜29）を空にしている
        KANA_SYM_LAYER {
            display-name = "kana_symbol";
            bindings = <
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 数字レイヤー（後で編集する。今は全キー透過）
        NUMBER_LAYER {
            display-name = "number";
            bindings = <
            &trans  &trans  &kp UP  &trans  &trans  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans
            &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_0  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // 記号レイヤー（後で編集する。今は全キー透過）
        SYMBOL_LAYER {
            display-name = "symbol";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
