#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/kana.dtsi>
#include <behaviors/mouse_button_toggle.dtsi>
#include <dt-bindings/lalapad/cursor_slow.h>

#define DEFAULT_LAYER   0
#define QWERTY_LAYER    1
#define SECONDARY_LAYER 2
#define TERTIARY_LAYER  3
#define SYSTEM_LAYER    4
#define MOUSE_LAYER     5
#define KANA_LAYER      6
#define KANA_L_LAYER    7
#define KANA_R_LAYER    8
#define KANA_SYM_LAYER  9

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // ===== カスタムキー（エディタで使いたいレイヤーに割り当てる） =====
        // 名前の頭で種類を分けている（clk_: クリック、cur_: カーソル、mod_: 修飾キー、pair_: カッコ、sym_: 記号）。
        // display-name は付けない（LaLapad-Gen2-Editor がレイヤーと誤認するため）。

        // --- clk_: クリック押しっぱなし（もう一度押す、または同じボタンのクリックで解除） ---
        // 左クリック押しっぱなし（旧 D.LCK）
        clk_lock_l: clk_lock_l {
            compatible = "zmk,behavior-mouse-button-toggle";
            #binding-cells = <0>;
            button = <LCLK>;
        };
        // 中クリック押しっぱなし（旧 D.MID）
        clk_lock_m: clk_lock_m {
            compatible = "zmk,behavior-mouse-button-toggle";
            #binding-cells = <0>;
            button = <MCLK>;
        };
        // 右クリック押しっぱなし（旧 D.RCK）
        clk_lock_r: clk_lock_r {
            compatible = "zmk,behavior-mouse-button-toggle";
            #binding-cells = <0>;
            button = <RCLK>;
        };

        // --- cur_: カーソル低速（1/3） ---
        // 押している間、カーソル低速（旧 SLOW）
        cur_slow_hold: cur_slow_hold {
            compatible = "zmk,behavior-cursor-slow";
            #binding-cells = <0>;
            mode = <CURSOR_SLOW_HOLD>;
        };
        // 押すたびにカーソル低速のオン・オフ（旧 T.SLO）
        cur_slow_toggle: cur_slow_toggle {
            compatible = "zmk,behavior-cursor-slow";
            #binding-cells = <0>;
            mode = <CURSOR_SLOW_TOGGLE>;
        };
        // 次のキーを押すまでカーソル低速（旧 O.SLO）
        cur_slow_once: cur_slow_once {
            compatible = "zmk,behavior-cursor-slow";
            #binding-cells = <0>;
            mode = <CURSOR_SLOW_ONESHOT>;
        };

        // --- mod_: 修飾キー押しっぱなし（もう一度押すと解除） ---
        // Left Alt 押しっぱなし（旧 A.LCK）
        mod_lock_alt: mod_lock_alt {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LALT>;
        };
        // Left Ctrl 押しっぱなし（旧 C.LCK）
        mod_lock_ctrl: mod_lock_ctrl {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LCTRL>;
        };
        // Left Shift 押しっぱなし（旧 S.LCK）
        mod_lock_shift: mod_lock_shift {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LSHIFT>;
        };
        // Left GUI（Win）押しっぱなし（旧 W.LCK）
        mod_lock_win: mod_lock_win {
            compatible = "zmk,behavior-key-lock";
            #binding-cells = <0>;
            keycode = <LGUI>;
        };

        // --- sym_: 記号（Windows の Alt コードで送るもの。IME の状態やローマ字テーブルに関係なく入る） ---
        // ― （ホリゾンタルバー）を入力。日本語 Windows（cp932）の Alt+33116（Shift_JIS 0x815C）で送る。
        // Num Lock がオフなら一時的にオンにして、送り終えたら元に戻す（CONFIG_ZMK_HID_INDICATORS）
        sym_hbar: sym_hbar {
            compatible = "zmk,behavior-alt-code";
            #binding-cells = <0>;
            codes = <33116>;
        };

        // --- かな入力（自作モジュール kana/）。Keymap Editor が認識できるよう、定義はこのファイルに置く ---
        // かな1文字を送る（&kana_key KN_A など。ID は kana/include/dt-bindings/kana/kana.h）
        kana_key: kana_key {
            compatible = "zmk,behavior-kana";
            #binding-cells = <1>;
            display-name = "Kana";
        };
        // かな配列モードのオン／オフ（&kana_sw KANA_SW_ON / KANA_SW_OFF）。layer はかな単打面
        kana_sw: kana_sw {
            compatible = "zmk,behavior-kana-mode";
            #binding-cells = <1>;
            display-name = "Kana Mode";
            layer = <KANA_LAYER>;
        };
    };

    // --- pair_: カッコの自動補完（開き・閉じを入力して ← でカーソルを中に置く） ---
    // display-name は付けない（LaLapad-Gen2-Editor がレイヤーと誤認するため）。
    macros {
        // 「」を入力してカーソルを中に。先に IME オン（LANGUAGE_1）を送り、[ ] を Google 日本語入力で「」にする
        // （入力後も IME はオンのまま）
        pair_kagi: pair_kagi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_tap &kp LANGUAGE_1 &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
        };
        // () を入力してカーソルを中に（IME の切り替えはしない。IME オンなら（）になる）
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp LPAR &kp RPAR &kp LEFT>;
        };

        // --- sym_: 記号 ---
        // … を入力。先に IME オン（LANGUAGE_1）を送り、Google 日本語入力の z. で … にする（入力後も IME はオンのまま）
        sym_ellipsis: sym_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_tap &kp LANGUAGE_1 &kp Z &kp PERIOD>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <DEFAULT_LAYER QWERTY_LAYER SECONDARY_LAYER TERTIARY_LAYER SYSTEM_LAYER MOUSE_LAYER>;
        };
        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <DEFAULT_LAYER QWERTY_LAYER SECONDARY_LAYER TERTIARY_LAYER SYSTEM_LAYER MOUSE_LAYER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
            &kp B  &kp F  &kp L  &kp K  &kp Q  &kp P  &kp G  &kp O  &kp U  &kp PERIOD
            &kp N  &kp S  &kp H  &kp T  &kp M  &kp Y  &kp C  &kp A  &kp E  &kp I
            &mt2 LEFT_SHIFT X  &kp V  &kp J  &kp D  &kp Z  &kp SQT  &kp W  &kp SLASH  &kp SEMI  &kp COMMA
            &kp LEFT_CONTROL  &kp LWIN  &kp LEFT_ALT  &mo SECONDARY_LAYER  &mt2 LEFT_SHIFT R  &kp ENTER  &kp BACKSPACE  &mt2 RIGHT_SHIFT SPACE  &mo TERTIARY_LAYER  &kp LANGUAGE_2  &kp LANGUAGE_1  &kp BACKSLASH
            &tog QWERTY_LAYER  &kp RIGHT  &kp DOWN  &kp LEFT  &kp UP  &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT  &kana_sw KANA_SW_ON
            &mkp LCLK  &mkp RCLK  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            &mkp MB4  &mkp MB5  &kp LG(TAB)  &kp LG(D)  &kp LEFT_CONTROL  &mkp MB4  &mkp MB5  &kp LG(TAB)  &kp LG(D)  &kp LEFT_CONTROL
            >;
        };

        // QWERTY 配列（Default は Night 配列 https://valorance.net/night/ ）。Default の上に重ねる。文字以外は透過で Default のまま。
        // 42 で Default（Night）と切り替える。親指は 34 = Space、35 = Shift、36 = BS、37 = Enter。
        // 番号の大きいレイヤーが優先されるので、数字・記号・マウス・かなが隠れないよう Default のすぐ上に置く。
        QWERTY_LAYER {
            display-name = "qwerty";
            bindings = <
            &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
            &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &mt2 EQUAL MINUS
            &mt2 LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
            &trans  &trans  &trans  &trans  &kp SPACE  &kp LEFT_SHIFT  &kp BACKSPACE  &kp ENTER  &trans  &trans  &trans  &trans
            &tog QWERTY_LAYER  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
            &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp EQUAL  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
            &trans  &trans  &trans  &trans  &trans  &trans  &kp DELETE  &trans  &trans  &kp KP_NUMBER_0  &kp KP_DOT  &kp KP_DIVIDE
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
            &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp PAGE_UP  &kp HOME  &kp UP  &kp END  &kp PRINTSCREEN
            &kp CARET  &kp AMPS  &kp ASTRK  &pair_paren  &pair_kagi  &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp SCROLLLOCK
            &kp GRAVE  &kp SQT  &kp SEMI  &sym_ellipsis  &sym_hbar  &trans  &mkp MB4  &trans  &mkp MB5  &kp PAUSE_BREAK
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
            &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &sys_reset  &bootloader  &bt BT_CLR  &bt BT_CLR_ALL  &trans
            &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE_LAYER {
            display-name = "mouse_layer";
            bindings = <
            &none  &kp LC(W)  &none  &clk_lock_l  &none  &none  &none  &none  &none  &none
            &none  &mkp MCLK  &mkp RCLK  &mkp LCLK  &none  &none  &none  &none  &none  &none
            &none  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none  &none  &none  &none  &none  &none
            &trans  &trans  &trans  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &trans  &kp LC(TAB)  &trans  &kp LC(LS(TAB))  &trans  &trans  &kp LC(LS(TAB))  &trans  &kp LC(TAB)  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        KANA_LAYER {
            display-name = "kana";
            bindings = <
            &kana_key KN_A  &kana_key KN_I  &kana_key KN_U  &kana_key KN_E  &kana_key KN_O  &kana_key KN_KA  &kana_key KN_KI  &kana_key KN_KU  &kana_key KN_KE  &kana_key KN_KO
            &kana_key KN_SA  &kana_key KN_SI  &kana_key KN_SU  &kana_key KN_SE  &kana_key KN_SO  &kana_key KN_TA  &kana_key KN_TI  &kana_key KN_TU  &kana_key KN_TE  &kana_key KN_TO
            &kana_key KN_NA  &kana_key KN_NI  &kana_key KN_NU  &kana_key KN_NE  &kana_key KN_NO  &kana_key KN_HA  &kana_key KN_HI  &kana_key KN_HU  &kana_key KN_HE  &kana_key KN_HO
            &none  &none  &none  &kana_key KN_SPACE  &mo KANA_L_LAYER  &kana_key KN_BSPC  &kana_key KN_ENTER  &mo KANA_R_LAYER  &none  &mo KANA_SYM_LAYER  &none  &none
            &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kana_sw KANA_SW_OFF
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        KANA_L_LAYER {
            display-name = "kana_left";
            bindings = <
            &kana_key KN_MA  &kana_key KN_MI  &kana_key KN_MU  &kana_key KN_ME  &kana_key KN_MO  &kana_key KN_YA  &kana_key KN_YU  &kana_key KN_YO  &kana_key KN_WA  &kana_key KN_WO
            &kana_key KN_RA  &kana_key KN_RI  &kana_key KN_RU  &kana_key KN_RE  &kana_key KN_RO  &kana_key KN_NN  &kana_key KN_GA  &kana_key KN_GI  &kana_key KN_GU  &kana_key KN_GE
            &kana_key KN_GO  &kana_key KN_ZA  &kana_key KN_ZI  &kana_key KN_ZU  &kana_key KN_ZE  &kana_key KN_ZO  &kana_key KN_DA  &kana_key KN_DI  &kana_key KN_DU  &kana_key KN_DE
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        KANA_R_LAYER {
            display-name = "kana_right";
            bindings = <
            &kana_key KN_DO  &kana_key KN_BA  &kana_key KN_BI  &kana_key KN_BU  &kana_key KN_BE  &kana_key KN_BO  &kana_key KN_PA  &kana_key KN_PI  &kana_key KN_PU  &kana_key KN_PE
            &kana_key KN_PO  &kana_key KN_XYA  &kana_key KN_XYU  &kana_key KN_XYO  &kana_key KN_XA  &kana_key KN_XI  &kana_key KN_XU  &kana_key KN_XE  &kana_key KN_XO  &kana_key KN_XTU
            &kana_key KN_VU  &kana_key KN_TOUTEN  &kana_key KN_KUTEN  &kana_key KN_CHOUON  &kana_key KN_SANTEN  &kana_key KN_EXCL  &kana_key KN_QUES  &kana_key KN_KAGI  &sym_hbar  &kana_key KN_PAREN
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // かな記号面（かな単打面の位置39を押している間）。記号は後で配置する。今は文字キー（0〜29）を空にしている
        KANA_SYM_LAYER {
            display-name = "kana_symbol";
            bindings = <
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <SECONDARY_LAYER TERTIARY_LAYER>;
            then-layer = <SYSTEM_LAYER>;
        };
    };
};
