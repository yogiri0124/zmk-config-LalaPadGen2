#include <dt-bindings/zmk/pointing.h>

/ {
    // マウスボタンの押しっぱなし切り替え（zmk,behavior-mouse-button-toggle）が共通で使う入力デバイス。
    // behavior のインスタンス（button = <LCLK> など）は keymap で定義する
    mouse_lock_input: mouse_lock_input {
        compatible = "zmk,mouse-button-lock-input";
    };

    // mouse_lock_input が出す INPUT_BTN_* を HID のマウスボタンに反映する（ZMK の mkp_input_listener と同じ形）
    mouse_lock_input_listener: mouse_lock_input_listener {
        compatible = "zmk,input-listener";
        device = <&mouse_lock_input>;
    };
};
