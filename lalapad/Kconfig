# このモジュールの behavior と入力処理は、keymap を処理する側（central。分割でなければ本体）でだけ使う
config LALAPAD_CENTRAL
    def_bool !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_BEHAVIOR_KANA
    bool "Kana romaji output behaviors (&kana_key, &kana_sw, zmk,behavior-kana-seq)"
    default y
    depends on LALAPAD_CENTRAL && (DT_HAS_ZMK_BEHAVIOR_KANA_ENABLED || DT_HAS_ZMK_BEHAVIOR_KANA_MODE_ENABLED || DT_HAS_ZMK_BEHAVIOR_KANA_SEQ_ENABLED)

config ZMK_BEHAVIOR_MOUSE_BUTTON_TOGGLE
    bool "Mouse button toggle behavior (zmk,behavior-mouse-button-toggle)"
    default y
    depends on LALAPAD_CENTRAL && ((DT_HAS_ZMK_BEHAVIOR_MOUSE_BUTTON_TOGGLE_ENABLED || DT_HAS_ZMK_MOUSE_BUTTON_LOCK_INPUT_ENABLED) && ZMK_POINTING)

config ZMK_CURSOR_SLOW
    bool "Cursor slow mode (zmk,behavior-cursor-slow, zmk,input-processor-cursor-slow)"
    default y
    depends on LALAPAD_CENTRAL && ((DT_HAS_ZMK_BEHAVIOR_CURSOR_SLOW_ENABLED || DT_HAS_ZMK_INPUT_PROCESSOR_CURSOR_SLOW_ENABLED) && ZMK_POINTING)

config ZMK_BEHAVIOR_KEY_LOCK
    bool "Key lock behavior (zmk,behavior-key-lock)"
    default y
    depends on LALAPAD_CENTRAL && (DT_HAS_ZMK_BEHAVIOR_KEY_LOCK_ENABLED)

config ZMK_AUTO_MOUSE_LAYER
    bool "Auto mouse layer input processor (zmk,input-processor-auto-mouse-layer)"
    default y
    depends on LALAPAD_CENTRAL && (DT_HAS_ZMK_INPUT_PROCESSOR_AUTO_MOUSE_LAYER_ENABLED && ZMK_POINTING)

config ZMK_BEHAVIOR_LAYER_LOCK
    bool "Layer lock behavior (zmk,behavior-layer-lock)"
    default y
    depends on LALAPAD_CENTRAL && DT_HAS_ZMK_BEHAVIOR_LAYER_LOCK_ENABLED

config ZMK_BEHAVIOR_WORD_LAYER
    bool "Word layer behavior (zmk,behavior-word-layer)"
    default y
    depends on LALAPAD_CENTRAL && DT_HAS_ZMK_BEHAVIOR_WORD_LAYER_ENABLED

config ZMK_BEHAVIOR_ALT_TAB
    bool "Alt+Tab window switcher behavior (zmk,behavior-alt-tab)"
    default y
    depends on LALAPAD_CENTRAL && (DT_HAS_ZMK_BEHAVIOR_ALT_TAB_ENABLED)

config ZMK_BEHAVIOR_ALT_CODE
    bool "Windows Alt code behavior (zmk,behavior-alt-code)"
    default y
    depends on LALAPAD_CENTRAL && (DT_HAS_ZMK_BEHAVIOR_ALT_CODE_ENABLED)

config ZMK_TP_KEYS
    bool "Trackpad to keys (zmk,behavior-tp-keys, zmk,behavior-tp-stroke, zmk,input-processor-tp-keys)"
    default y
    depends on LALAPAD_CENTRAL && ((DT_HAS_ZMK_BEHAVIOR_TP_KEYS_ENABLED || DT_HAS_ZMK_BEHAVIOR_TP_STROKE_ENABLED || DT_HAS_ZMK_INPUT_PROCESSOR_TP_KEYS_ENABLED) && ZMK_POINTING)

config ZMK_SCROLL_SNAP_GATE
    bool "Scroll snap hold (zmk,behavior-scroll-snap-hold, zmk,input-processor-scroll-snap-gate)"
    default y
    depends on LALAPAD_CENTRAL && ((DT_HAS_ZMK_BEHAVIOR_SCROLL_SNAP_HOLD_ENABLED || DT_HAS_ZMK_INPUT_PROCESSOR_SCROLL_SNAP_GATE_ENABLED) && ZMK_POINTING)

config ZMK_POSITION_RELAY
    bool "Process position events raised outside the system work queue on the system work queue"
    default y
    depends on LALAPAD_CENTRAL
    help
      トラックパッドのタップ・ジェスチャーなど、入力スレッドから出たキー位置の出来事を預かり、キーマップと
      behavior の処理をシステムワークキューで行う（lalapad/src/position_relay.c）。

config ZMK_KEY_STREAM
    bool "Send key position events to the host over a vendor raw HID (USB and BLE)"
    depends on LALAPAD_CENTRAL
    depends on ZMK_USB || ZMK_BLE
    help
      キーが押された／離されたときに、その位置番号を raw HID で PC のアプリに送る（lalapad/src/key_stream.c）。
      アプリから「開始」を受けている間だけ送る。USB で使うときは CONFIG_USB_HID_DEVICE_COUNT=2 も必要。

if ZMK_KEY_STREAM

config ZMK_KEY_STREAM_USB
    bool "Key stream over USB (a second USB HID device)"
    default y
    depends on ZMK_USB

config ZMK_KEY_STREAM_BLE
    bool "Key stream over BLE (a second HID over GATT service)"
    default y
    depends on ZMK_BLE

endif
